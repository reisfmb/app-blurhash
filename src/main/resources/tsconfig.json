{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    // XP runtime globals (resolve, app, log, __, ...) — vp pack does the emit.
    "types": ["@enonic-types/global"],
    // Type the absolute XP requires; vp pack keeps them external at build time.
    "paths": {
      "/lib/xp/core": ["../../../node_modules/@enonic-types/core"],
      "/lib/xp/*": ["../../../node_modules/@enonic-types/lib-*"],
      "/lib/enonic/react4xp": ["../../../node_modules/@enonic-types/lib-react4xp"],
      // lib-blurhash has no npm package; type against the sibling checkout (dev only — the
      // deploy loop in README already assumes this layout).
      "/lib/blurhash": ["../../../../lib-blurhash/src/main/resources/lib/blurhash/index.ts"],
      "/lib/blurhash/*": ["../../../../lib-blurhash/src/main/resources/lib/blurhash/*"],
      // App-local absolute requires (XP resolves them at runtime).
      "/react4xp/*": ["./react4xp/*"],
      "/types/*": ["./types/*"],
      "/lib/*": ["./lib/*"]
    }
  },
  "include": ["./**/*.ts"],
  "exclude": ["assets/**", "**/*.tsx"]
}
